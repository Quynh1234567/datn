CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Một lần chạy HS (64 vòng) có thể mất > 1 s – tắt watchdog tác vụ để không bị báo lỗi giữa chừng
CONFIG_ESP_TASK_WDT_INIT=n

# PSRAM Octal (N8R8, N16R8). Board PSRAM Quad: đổi sang CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# malloc thường không tự lấy PSRAM – chương trình tự chọn vùng nhớ bằng heap_caps_malloc
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# -O2, giống bản đo trên PC (scripts/23_hs_cpu_bench.py --cflags -O2)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
