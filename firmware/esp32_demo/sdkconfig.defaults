CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# PSRAM Octal (N8R8 / N16R8). Board PSRAM Quad: CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Console 921 600 baud để gửi ảnh xem trước cho PC (scripts/27_demo_monitor.py --esp).
# Nếu monitor ra ký tự rác: đổi về 115200 và tắt xem trước (DEMO_PREVIEW_EVERY = 0).
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

CONFIG_COMPILER_OPTIMIZATION_PERF=y
